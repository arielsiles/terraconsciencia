AddDefaultCharset UTF-8
AddType application/pdf .pdf

RewriteEngine on
#RewriteCond %{HTTP_HOST} ^terraconsciencia\.com$ [OR]
#RewriteCond %{HTTP_HOST} ^www\.terraconsciencia\.com$
RewriteRule ^/?$ "http://localhost/terraco/SinLogin.php" [R=301,L]

<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
    Header set Access-Control-Allow-Credentials true
</IfModule>

# Límites PHP para subida de archivos PURISKIRI (150MB de margen para configuración dinámica)
php_value upload_max_filesize 150M
php_value post_max_size 160M
php_value max_execution_time 300
php_value max_input_time 300
